; fvp-launcher.ini — 放在 FVPLauncher.exe 的同目录 (一般就是游戏目录)
; 这个文件可以完全没有: 没有它时按"内置默认值"跑 (等价于下面注释掉的写法)。
; 行首 ; 或 # 是注释。
; 用 FVPBind.exe 绑过钩子的游戏 (目录里没有 FVPLauncher.exe) 读的是同一个文件、同一套默认值。

[launcher]
exe =                    ; 留空 = 扫描本目录, 挑出导入 shell32!SHGetFolderPathA 的 FVP 主程序
params =                 ; 附加命令行参数, 原样拼在 exe 路径后面
workdir =                ; 留空 = 启动器所在目录
inject_children = 1      ; 汉化版是 SakuraChs.exe -> Sakura.exe 链式启动, 需要 1 (内置默认 0)
; icon =                 ; 换游戏窗口图标: 填 .ico (或另一个 .exe) 的路径; 相对路径按游戏目录解析

[save]
; 整段省略 = redirect 1 / path userdata / migrate 1
redirect = 1             ; 1 = 把"文档"目录的存档根改写到 path
path = .                 ; "." = 游戏目录本身; 也可写 userdata 或绝对路径 D:\saves\sakura
migrate = 0              ; 首次运行把真"文档"里的老档复制过来 (目标已存在的文件跳过, 源不删)
migrate_names = FAVORITE ; 迁移哪些一级目录, ; 分隔; "*" = 文档下全部
folder_ids = 5           ; 被改写的 CSIDL 列表 (5=Documents), 逗号分隔

[nls]
; 整段省略 = codepage 跟随本机, font_charset 按 codepage 推导, virtualize_ui 关
; codepage = 932         ; 虚拟 ACP: 932=日文 936=简体 950=繁体 949=韩文 1252=拉丁 65001=UTF-8
; ↑ 留空 / 整行删掉 / 写 auto = 用"本机真实 ACP"(中文 Windows = 936), 这是最安全的默认。
;   实测: 中文 Windows 上为了跑日文原版填 932, 引擎却是拿宿主 ACP(936) 的字节拼资源路径的,
;   谎报后 A↔W 往返不再恒等 → 游戏自己弹「graph/main_windowのオープンに失敗しました」。
;   只有"非日文区 Windows + 纯日文游戏"才需要 932 —— 那正是替代 Locale Emulator 的用法。
; font_charset = 128     ; GDI 字符集; 留空/删掉 = 按 codepage 推导 (932→128 936→134 950→136 949→129)
virtualize_files = 1     ; 把 CreateFileA 等文件 API 换成按 codepage 解释的 W 版
; text_codepage = 936    ; 【文字层】单独一档: 界面/剧本字节用哪个码页变成字形。留空/0 = 完全不碰
; ↑ codepage 管的是"系统 API 假装成哪个区域"(路径、句柄名), text_codepage 管的是"画面上的字怎么画"。
;   FVP 引擎自己用 CreateFontA + GetGlyphOutlineA 逐字画文字, 字节→字形由字体 lfCharSet 决定:
;   日文引擎本体 + 中文剧本 (常见于同人作品) 会出现"系统弹框正常、游戏里的字全乱码",
;   这时光有 codepage = 936 不够 (机器本来就是 936, 等于空操作), 要写 text_codepage = 936。
;   日文原版在非日文区系统上想正确显示日文 = 932; 想要 UTF-8 剧本 = 65001。
;   汉化包自带文本层 (filter.dll + libass) 时必须保持 0, 否则两层叠加, 标题与对话一起错乱。
virtualize_ui = 0        ; 虚拟化 LoadStringA / MessageBoxA / CreateFontA / GetGlyphOutlineA
; ↑ 内置默认跟随 text_codepage (开了文本层才开); 显式写 0/1 可单独覆盖。
lcid = 0                 ; 非 0 (如 0x411) 时让 lstrcmpiA 按该 locale 比较
